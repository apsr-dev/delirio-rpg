{
  "name": "delirio-rpg",
  "version": "0.1.0",
  "private": true,
  "description": "Delirio RPG Telegram bot built with Bun, TypeScript, grammY, Supabase, and Vercel webhooks.",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit",
    "openspec:list": "openspec list",
    "openspec:validate": "openspec validate --all",
    "openspec:view": "openspec view",
    "set-webhook": "bun run scripts/set-webhook.ts",
    "delete-webhook": "bun run scripts/delete-webhook.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.52.0",
    "grammy": "^1.36.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vercel": "^44.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
