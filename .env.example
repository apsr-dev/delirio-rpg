# Telegram
BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret

# Public production URL, for example:
# https://delirio-rpg.vercel.app
PUBLIC_WEBHOOK_BASE_URL=https://replace-me.vercel.app

# Protects /api/setup-webhook so only you can call it.
SETUP_WEBHOOK_SECRET=replace_with_a_different_random_secret

# Supabase server-side credentials.
# Keep the service role key server-only. Never expose it in browser code.
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
